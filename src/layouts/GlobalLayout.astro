---
import styles from "./GlobalLayout.module.css";
import "~/styles/app.css";
import "destyle.css";
import { ClientRouter } from "astro:transitions";

const { title, description, type, thumbnail } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const thumbnailUrl = thumbnail ? new URL(thumbnail, Astro.site) : null;

const siteName = "たくしいのこんせき";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${siteName}` : siteName}</title>
    {description && (
      <meta
        name="description"
        content={description}
      />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={type || "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    {description && (
      <meta
        name="og:description"
        content={description}
      />
    )}
    {thumbnail && <meta property="og:image" content={thumbnailUrl} />}
    <meta name="twitter:site" content="@takusea" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={url} />
		<link rel="icon" href="/favicon.png" type="image/png">
    <script src="/pagefind/pagefind.js" type="module" is:inline></script>
    <script type="module" is:inline>
      import * as pagefind from "/pagefind/pagefind.js";
      window.pagefind = pagefind;
    </script>
    <script is:inline>
      const theme = document.cookie
        .split("; ")
        .find((cookie) => cookie.startsWith("theme="))
        ?.slice("theme=".length);

      if (theme) {
        document.documentElement.dataset.theme = theme;
      }

      const hue = ((Date.now() % 86400000) / 86400000) * 360;
      document.documentElement.style.setProperty("--hue", hue.toString());
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class={styles.wrapper}>
      <div class={styles.grid}>
        <header class={styles.header}>
          <slot name="header" />
        </header>
        <aside class={styles.sideTop}>
          <slot name="sidebar-top" />
          <div class={styles.sideBottom}>
            <slot name="sidebar-bottom" />
          </div>
        </aside>
        <main class={styles.main}>
          <slot />
        </main>
        <div class={styles.mobile}>
          <slot name="sidebar-bottom" />
        </div>
      </div>
      <footer class={styles.footer}>©2026 takusea</footer>
    </div>
  </body>
</html>
