---
import styles from "./GlobalLayout.module.css";
import "~/styles/app.css";
import "destyle.css";
import { ClientRouter } from "astro:transitions";

const { title, description, type, thumbnail } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const thumbnailUrl = thumbnail ? new URL(thumbnail, Astro.site) : null;

const siteName = "たくしいのこんせき";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${siteName}` : siteName}</title>
    {description && (
      <meta
        name="description"
        content={description}
      />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={type || "website"} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    {description && (
      <meta
        name="og:description"
        content={description}
      />
    )}
    {thumbnail && <meta property="og:image" content={thumbnailUrl} />}
    <meta name="twitter:site" content="@takusea" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={url} />
		<link rel="icon" href="/favicon.png" type="image/png">
    <script src="/pagefind/pagefind.js" type="module" is:inline></script>
    <script type="module" is:inline>
      import * as pagefind from "/pagefind/pagefind.js";
      window.pagefind = pagefind;
    </script>
    <script is:inline>
      const initTheme = () => {
        const theme = document.cookie
          .split("; ")
          .find((cookie) => cookie.startsWith("theme="))
          ?.slice("theme=".length);

        if (theme) {
          document.documentElement.dataset.theme = theme;
        }
        const hue = ((Date.now() % 86400000) / 86400000) * 360;
        document.documentElement.style.setProperty("--hue", hue.toString());
      }
      initTheme();
      document.addEventListener("astro:after-swap", initTheme);
    </script>
    <script is:inline>
      const getCurrentXTheme = () => {
        const storedTheme = document.documentElement.dataset.theme;

        if (storedTheme === "device") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        return storedTheme;
      };

      const renderXPostEmbeds = () => {
        const theme = getCurrentXTheme();

        for (const post of document.querySelectorAll(".x-post-embed")) {
          const url = post.dataset.xPostUrl;
          if (!url) {
            continue;
          }

          const blockquote = document.createElement("blockquote");
          blockquote.className = "twitter-tweet";
          blockquote.dataset.conversation = "none";
          blockquote.dataset.theme = theme;
          blockquote.style.height = `${post.clientHeight}px`;
          blockquote.innerHTML = `<a href="${url}">X post</a>`;

          post.replaceChildren(blockquote);
        }

        window.twttr.widgets.load();
      };

      const ensureXWidgets = () => {
        if (window.twttr) {
          renderXPostEmbeds();
          return;
        }

        if (!document.querySelector('script[src*="platform.twitter.com/widgets.js"]')) {
          const script = document.createElement("script");
          script.src = "https://platform.twitter.com/widgets.js";
          script.async = true;
          script.addEventListener("load", renderXPostEmbeds);
          document.head.appendChild(script);
        }
      };

      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      mediaQuery.addEventListener("change", () => {
        if (document.documentElement.dataset.theme === "device") {
          renderXPostEmbeds();
        }
      });

      const themeObserver = new MutationObserver((mutations) => {
        if (mutations.some((mutation) => mutation.attributeName === "data-theme")) {
          renderXPostEmbeds();
        }
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      document.addEventListener("DOMContentLoaded", ensureXWidgets);
      document.addEventListener("astro:after-swap", ensureXWidgets);
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class={styles.wrapper}>
      <div class={styles.grid}>
        <header class={styles.header}>
          <slot name="header" />
        </header>
        <aside class={styles.sideTop}>
          <slot name="sidebar-top" />
          <div class={styles.sideBottom}>
            <slot name="sidebar-bottom" />
          </div>
        </aside>
        <main class={styles.main}>
          <slot />
        </main>
        <div class={styles.mobile}>
          <slot name="sidebar-bottom" />
        </div>
      </div>
      <footer class={styles.footer}>©2026 takusea</footer>
    </div>
  </body>
</html>
