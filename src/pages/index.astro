---
import { getCollection } from "astro:content";
import { HomeContent } from "~/components/HomeContent";
import { ProfileCard } from "~/components/ProfileCard";
import { SearchCard } from "~/components/SearchCard";
import { ThemeSwitcher } from "~/components/ThemeSwitcher";
import GlobalLayout from "~/layouts/GlobalLayout.astro";
import type { PostMetadata } from "~/type/post";
import styles from "./index.module.css";

const posts = (await getCollection("posts"))
	.map(
		(entry) =>
			({
				...entry.data,
				slug: entry.id,
				thumbnail: entry.data.thumbnail,
			}) as PostMetadata,
	)
	.toSorted((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<GlobalLayout title="たくしいのこんせき" description="雑記だとか備忘録だとかを残すブログです。たくしいはお絵描き・動画投稿・プログラミング・ゲームなどをするひとです。">
  <Fragment slot="header">
    <h1 class={styles.logo} aria-label="たくしいのこんせき"></h1>
    <p>雑記だとか備忘録だとか。</p>
  </Fragment>

  <Fragment slot="sidebar-top">
    <SearchCard client:load />
  </Fragment>

  <HomeContent posts={posts} client:load />

  <Fragment slot="sidebar-bottom">
    <ProfileCard />
    <ThemeSwitcher client:load />
  </Fragment>
</GlobalLayout>