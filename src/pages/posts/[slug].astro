---
import { getCollection, render } from "astro:content";
import { IconCalendar, IconTag } from "@tabler/icons-solidjs";
import { DocumentView } from "~/components/DocumentView";
import { LatestPostsCard } from "~/components/LatestPostsCard";
import { ProfileCard } from "~/components/ProfileCard";
import { SearchCard } from "~/components/SearchCard";
import { TagListView } from "~/components/TagListView";
import { ThemeSwitcher } from "~/components/ThemeSwitcher";
import { TocCard } from "~/components/TocCard";
import GlobalLayout from "~/layouts/GlobalLayout.astro";
import type { PostMetadata, PostToc } from "~/type/post";
import styles from "./[slug].module.css";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { slug } = Astro.params;
const posts = await getCollection("posts");
const post = Astro.props.post ?? posts.find((entry) => entry.id === slug);

const { Content, headings } = await render(post);

const toc = headings.reduce<PostToc[]>((tree, heading) => {
	const item: PostToc = {
		id: heading.slug,
		value: heading.text,
		children: [],
	};
	let level = heading.depth;
	let branch = tree;

	while (level > 2 && branch.at(-1)) {
		branch = branch.at(-1)?.children ?? branch;
		level -= 1;
	}

	branch.push(item);
	return tree;
}, []);

const latestPosts = posts
	.filter((entry) => entry.id !== post.id)
	.slice(0, 5)
	.map((entry) => ({ ...entry.data, slug: entry.id }) as PostMetadata);
---

<GlobalLayout title={post.data.title} description={post.data.description} type="article" thumbnail={`posts/${slug}.png`}>
  {post.data.thumbnail && (
    <div
      class={styles.background}
      style={`--background: url(${post.data.thumbnail.src})`}
    >
    </div>
  )}

  <Fragment slot="header">
    <a href="/" class={styles.logo} aria-label="たくしいのこんせき"></a>
    <h1 class={styles.title}>{post.data.title}</h1>
    <div class={styles.metadata}>
      <time class={styles.date} datetime={post.data.date} data-pagefind-sort="date[datatime]">
        <IconCalendar />
        {post.data.date}
      </time>
      <div class={styles.tag}>
        <IconTag />
        <TagListView
          tags={post.data.tags}
          asPagefindFilter
          client:load
        />
      </div>
    </div>
  </Fragment>

  <Fragment slot="sidebar-top">
    <SearchCard client:load />
    {toc.length !== 0 && <TocCard toc={toc} client:load />}
  </Fragment>

  <DocumentView>
    <Content />
  </DocumentView>

  <Fragment slot="sidebar-bottom">
    <LatestPostsCard posts={latestPosts} client:load />
    <ProfileCard />
    <ThemeSwitcher client:load />
  </Fragment>
</GlobalLayout>
